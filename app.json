{
  "expo": {
    "name": "Pivi Games",
    "slug": "game-hub-pivi",
    "owner": "taske",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pivigames",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pivi.gamehubpivi",
      "appleTeamId": "LC36GJM5WG",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pivi.gamehubpivi",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon-adaptive.png"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-9119808783860406~2374208392"
        }
      ],
      "expo-iap",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets us show you ads that are more relevant to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc612faf-60e1-4438-b2c3-a09d90692cd6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fc612faf-60e1-4438-b2c3-a09d90692cd6",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
